{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfjs-dist/**"
    }
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/pdfjs-dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

