# ============================================================
# Backend Environment Variables — Vercel Production
# ============================================================
# انسخ هذه المتغيرات في Vercel Dashboard > Settings > Environment Variables
# (لا ترفع هذا الملف — بس للمرجعية)

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-a-strong-random-64-char-secret>
JWT_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=<generate-a-strong-random-secret>

# CORS — ضع رابط الفرونت‑إند على Vercel
FRONTEND_URL=https://your-frontend.vercel.app

# Node environment
NODE_ENV=production

# Upload settings (ملاحظة: Vercel serverless لا يدعم تخزين ملفات دائم)
# استخدم Cloudinary أو S3 للصور في الإنتاج
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/
